{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uibcdf.org/gh-run-receptor/schemas/events-v1.schema.json",
  "title": "gh-run-receptor.events@1",
  "type": "object",
  "required": ["schema", "producer", "subject", "events"],
  "properties": {
    "schema": {"const": "gh-run-receptor.events@1"},
    "producer": {
      "type": "object",
      "required": ["repository", "ref"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$", "maxLength": 512},
        "ref": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["repository", "run_id", "run_attempt", "head_sha", "job_key", "matrix_index"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$", "maxLength": 512},
        "run_id": {"type": "integer", "minimum": 1},
        "run_attempt": {"type": "integer", "minimum": 1},
        "head_sha": {"type": "string", "minLength": 1, "maxLength": 512},
        "job_key": {"type": "string", "minLength": 1, "maxLength": 512},
        "matrix_index": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {"$ref": "#/$defs/event"}
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": ["kind", "platform", "artifact", "sha256", "build", "upload"],
      "properties": {
        "kind": {"const": "conda.package"},
        "platform": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+){0,3}$", "maxLength": 512},
        "artifact": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^/\\\\]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "build": {"enum": ["success", "failure", "not_requested"]},
        "upload": {"enum": ["success", "failure", "not_requested"]},
        "python_versions": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 40}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

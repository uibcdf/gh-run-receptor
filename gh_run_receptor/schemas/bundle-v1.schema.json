{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uibcdf.org/gh-run-receptor/schemas/bundle-v1.schema.json",
  "title": "gh-run-receptor.bundle@1",
  "type": "object",
  "required": [
    "schema", "repository", "hostname", "run_id", "run_attempt", "head_sha",
    "api_version", "receptor_version", "capture_policy", "captured_at", "complete",
    "members", "warnings"
  ],
  "properties": {
    "schema": {"const": "gh-run-receptor.bundle@1"},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "hostname": {"type": "string", "minLength": 1, "pattern": "^[^/]+$"},
    "run_id": {"type": "integer", "minimum": 1},
    "run_attempt": {"type": "integer", "minimum": 1},
    "head_sha": {"type": ["string", "null"]},
    "api_version": {"type": "string", "minLength": 1},
    "receptor_version": {"type": "string", "minLength": 1},
    "capture_policy": {"enum": ["full", "adaptive", "metadata"]},
    "captured_at": {"type": "string", "format": "date-time"},
    "complete": {"type": "boolean"},
    "members": {
      "type": "array",
      "items": {"$ref": "#/$defs/member"}
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "member": {
      "type": "object",
      "required": ["path", "kind", "bytes", "sha256", "complete"],
      "properties": {
        "path": {"type": "string", "pattern": "^[^/\\\\]+$"},
        "kind": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "complete": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

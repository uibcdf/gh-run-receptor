#!/usr/bin/env python3
"""Launch this exact source extension without borrowing an installed product."""

import os
import subprocess
import sys
from pathlib import Path

if __name__ == "__main__":
    environment = os.environ.copy()
    environment["PYTHONPATH"] = str(Path(__file__).resolve().parent / "src")
    try:
        status = subprocess.call(
            [sys.executable, "-m", "gh_run_receptor", *sys.argv[1:]], env=environment
        )
    except KeyboardInterrupt:
        status = 130
    raise SystemExit(status)
